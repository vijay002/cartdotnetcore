@model List<ItemModelView>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<p>Item</p>
<div class="row">
    <div class="col-12">
        <div>
            
            <div class="align-content-end flex-column">
                <a asp-action="CreateItem" asp-controller="item" class="btn btn-primary align-items-end"> Add </a>
            </div>


            <div class="row">
                <div class="col-12">
                <table class="table table-bordered">
                    <tr>
                        <th>Name </th>
                        <th>Description </th>
                        <th>Quantity </th>
                        <th>Price </th>
                        @* <th>Images</th> *@
                        <th>Action</th>
                    </tr>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name </td>
                            <td>@item.Description </td>
                            <td>@item.Quantity </td>
                            <td>@item.Price </td>
                            @* <td>
                                <div class="card" style="width:5rem;">
                                    <div class="card-body">
                                        <image src="@item.ImagePath" class="card-img-top item-img rounded-3 w-20"></image>
                                    </div>
                                    <div class="card-title">@item.Category</div>
                                    <div class="card-text"> @item.Description</div>
                                    
                                </div>
                            </td> *@
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href='@Url.Action("edit", "item", new { id = @item.Id })'>Edit</a>
                                <a class="btn btn-sm btn-outline-danger" href='@Url.Action("delete", "item", new { id = @item.Id  } )'
                                onclick="return confirm('are you want to delete ?')"
                                >Delete</a>
                            </td>
                        </tr>
                    }
                </table>

                </div>
            </div>

        </div>
    </div>
</div>
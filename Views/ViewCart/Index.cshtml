@{
}
<p>ViewCart</p>

<div class="container py-5 h-100">
    <div class="row ">
        <div class="col-8">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <div class="col-3">
                        <div class="card">
                            <div class="card-body">
                                <img src="@item.ImagePath" title="" class="img-fluid rounded-3" />
                                <span> <label>Category</label>   @item.Category</span><br />
                                <span> <label class="fw-bold">Quantity:</label>   @item.Quantity</span><br />
                                <span> <label>Price:</label>  @item.Price</span><br />
                                <a class="fa fa-trash" href="@Url.Action("remove", "viewcart", new { id = item.Id })"> remove </a>
                            </div>

                        </div>

                    </div>


                    @*  @item.Name
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-row align-content-between">
                            <div class="1row">
                                <div class="">
                                    <img src="@item.ImagePath"
                                         class="img-fluid rounded-3" />
                                </div>
                                <div class=" ms-3">
                                    <h5>@item.Name</h5>

                                </div>
                                <div class="">
                                    <p class="small mb-0">@item.Description</p>
                                    <p>@item.Quantity</p>
                                </div>
                                <div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div> *@


                }

            }
            else
            {
                <div>No Item found.</div>
            }
        </div>
        <div class="col-4 mb-3">

            @if (Model != null && Model.Count > 0)
            {
                <div class="card rounded-2 p-2 bg-white">
                    @foreach (var item in Model)
                    {
                    <div>@item.Name &nbsp;@item.Quantity</div>
                    <br />
                    }
                    <div class="mt-3">
                        <form asp-action="CheckOut" asp-controller="viewcart">
                            <button class="form-control btn btn-primary" type="submit">
                                checkout
                            </button>
                        </form>

                    </div>
                </div>
            }



        </div>
    </div>




</div>